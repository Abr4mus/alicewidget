<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootWidgetCanvasContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- High-DPI Full-Card Canvas Rendered Bitmap -->
    <ImageView
        android:id="@+id/ivWidgetCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Виджет климата 2x2"
        android:scaleType="fitXY" />

    <!-- Transparent Touch Hotspot: Open Main App -->
    <FrameLayout
        android:id="@+id/btnWidgetOpenApp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Action Hotspots in Top-Right: Settings & Instant Refresh -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnWidgetConfigure"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_btn_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:contentDescription="Настроить"
                android:src="@drawable/ic_gear" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:alpha="0.85"
                android:contentDescription="Обновить"
                android:src="@drawable/ic_refresh" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
