<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayoutCompact"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alice_widget_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header (No logo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCompactRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Климат"
            android:textColor="@color/alice_text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_thermometer" />
    </LinearLayout>

    <!-- Big Temperature Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCompactTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23.5°"
            android:textColor="@color/alice_text_white"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Humidity Metric -->
    <LinearLayout
        android:id="@+id/layoutCompactHumidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_alice_tile"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_humidity" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Влажность: "
            android:textColor="@color/alice_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCompactHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="48%"
            android:textColor="@color/sensor_humidity_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
