<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayoutCompact"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alice_widget_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_alice_gradient_circle">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alice_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCompactRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Гостиная"
            android:textColor="@color/alice_text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Big Temperature Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCompactTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23.5°"
            android:textColor="@color/alice_text_white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Климат дома"
            android:textColor="@color/alice_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Metrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_alice_tile"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Влажность"
                android:textColor="@color/alice_text_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvCompactHumidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48%"
                android:textColor="@color/sensor_humidity_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="4dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_alice_tile"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Давление"
                android:textColor="@color/alice_text_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvCompactPressure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="752"
                android:textColor="@color/alice_text_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
