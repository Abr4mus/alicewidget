<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alice_purple_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Настройка"
                android:src="@drawable/ic_alice_app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvConfigWidgetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настройка виджета"
                    android:textColor="@color/alice_text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConfigWidgetSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Индивидуальные устройства и показатели"
                    android:textColor="@color/alice_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 1: THEME SELECTION & TITLE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/alice_purple_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 Стиль оформления этого виджета"
                    android:textColor="@color/alice_text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgConfigTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbConfigThemeXiaomi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tile_xiaomi"
                        android:buttonTint="@color/xiaomi_accent_teal"
                        android:checked="true"
                        android:padding="10dp"
                        android:text="🤖 Xiaomi HyperOS (обсидиановый акрил, кольцевой датчик)"
                        android:textColor="@color/xiaomi_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbConfigThemeIos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tile_ios"
                        android:buttonTint="@color/ios_accent_blue"
                        android:padding="10dp"
                        android:text="🍏 iPhone / iOS (Apple Frosted Glass 26dp, SF-минимализм)"
                        android:textColor="@color/ios_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbConfigThemeAlice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tile_alice"
                        android:buttonTint="@color/alice_neon_purple"
                        android:padding="10dp"
                        android:text="💜 Яндекс / Алиса (космический фиолетовый неон)"
                        android:textColor="@color/alice_text_white"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbConfigThemeAndroid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tile_android"
                        android:buttonTint="@color/android_accent_mint"
                        android:padding="10dp"
                        android:text="🤖 Android Material You (акриловый графит, пастель)"
                        android:textColor="@color/alice_text_white"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbConfigThemeNothing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tile_xiaomi"
                        android:buttonTint="@color/white"
                        android:padding="10dp"
                        android:text="🔴 Nothing OS (монохромный хай-тек, минимализм)"
                        android:textColor="@color/alice_text_white"
                        android:textSize="13sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="🏷️ Название виджета (необязательно)"
                    android:textColor="@color/alice_text_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etConfigTitle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tile_xiaomi"
                    android:hint="Например: Гостиная, Второй этаж"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/alice_text_white"
                    android:textColorHint="@color/alice_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: DEVICE SELECTION FOR THIS WIDGET -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/alice_purple_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Устройства для этого виджета"
                    android:textColor="@color/alice_text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Отметьте, какие устройства привязать к этому виджету и какие показатели отображать:"
                    android:textColor="@color/alice_text_muted"
                    android:textSize="12sp" />

                <!-- Room Filter Scroll Row -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutRoomChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <!-- Populated with room filter chips -->
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/layoutConfigDevicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                    <!-- Populated programmatically -->
                </LinearLayout>

                <Button
                    android:id="@+id/btnConfigSave"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/alice_neon_purple"
                    android:text="💾 Сохранить и применить к этому виджету"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
