<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootWidgetCanvasContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- High-DPI Full-Card Canvas Rendered Bitmap -->
    <ImageView
        android:id="@+id/ivWidgetCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Главный смарт-хаб датчиков"
        android:scaleType="fitXY" />

    <!-- Transparent Touch Hotspot: Open Main App -->
    <FrameLayout
        android:id="@+id/btnWidgetOpenApp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Action Hotspot in Top-Right: Settings Only -->
    <FrameLayout
        android:id="@+id/btnWidgetConfigure"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_btn_ripple"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivWidgetConfigure"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:alpha="0.85"
            android:contentDescription="Настроить этот виджет"
            android:src="@drawable/ic_gear" />
    </FrameLayout>

</FrameLayout>
